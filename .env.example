# ============================================================
# SAHAYAK — environment configuration
# Copy this file to "server/.env" and fill in values.
#   Windows PowerShell:  Copy-Item .env.example server\.env
# NEVER commit server/.env to Git (it is in .gitignore).
# ============================================================

# ---- Server ----
# Port the backend listens on. Frontend dev server proxies /api here.
PORT=4000

# SQLite database file location (created automatically).
# Leave empty to use the default: <project>/database/sahayak.db
# DB_PATH=

# ---- Demo admin account ----
# Created automatically on first start if no admin exists.
# CHANGE the password before demonstrating (do NOT commit the real value).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sahayak123

# Admin login sessions expire after this many hours.
SESSION_TTL_HOURS=12

# ---- Scheduler ----
# How often (milliseconds) the backend scheduler polls for due reminders.
SCHEDULER_INTERVAL_MS=10000
# Max send attempts per reminder before marking SEND_FAILED.
MAX_REMINDER_ATTEMPTS=3
# Backoff between retries: attempt N waits RETRY_BACKOFF_SECONDS * N.
RETRY_BACKOFF_SECONDS=60

# ---- Public base URL used inside patient response links ----
# Local testing: http://localhost:4000 (only reachable on THIS computer).
# For links that reach a real phone you need a secure HTTPS tunnel
# (see docs/WHATSAPP-LIVE-SETUP.md) and its URL here, e.g. https://abcd.ngrok.app
PUBLIC_BASE_URL=http://localhost:4000

# ---- Official WhatsApp Cloud API (Meta) — LIVE mode only ----
# All values below are OPTIONAL. Without them SAHAYAK runs in DEMO mode
# (simulated messages, no external calls). Get them from
# https://developers.facebook.com (see docs/WHATSAPP-LIVE-SETUP.md).
# Never paste real values into source code — only into this file.

# Permanent access token for your WhatsApp Business app.
WHATSAPP_ACCESS_TOKEN=

# The "Phone number ID" of your WhatsApp business number (Meta dashboard).
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA) — needed for template management.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Graph API version to call. v22.0 is a current stable version.
WHATSAPP_GRAPH_API_VERSION=v22.0

# Webhook verification token — any random string YOU invent here, then
# enter the SAME value in the Meta webhook configuration screen.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta app secret (App settings > Basic) — used to verify the
# X-Hub-Signature-256 signature of incoming webhook payloads.
WHATSAPP_APP_SECRET=
